# Root build context is used by the agent images and the two-hop services
# (compose sets context: .. so they can share delegation-common). Allow just
# what those builds need; key material (infra/pki, spire bootstrap) must never
# enter a build context.
*
!agent-client
!agent-pki
!cert-service
!delegation-common
!console
agent-client/target
agent-pki/target
cert-service/target
delegation-common/target
console/node_modules
console/dist
console/.angular
