# Never commit key material (infra/pki file contract); certs there are
# lab-instance artifacts regenerated by setup-ejbca.sh
infra/pki/**/*.pem
infra/pki/.old-lab-hierarchy/
infra/spire/bootstrap/
*.key
*.p12
*.jks

# Secrets / env
.env
.env.*

# Build output
target/
build/
out/
*.class

# Logs & runtime state
logs/
*.log

# IDE / OS noise
.idea/
.vscode/
.claude/*.lock
*.iml
Thumbs.db
.DS_Store
*.srl
!.env.example
