    {"id":"t-title","type":"text","x":280,"y":16,"width":1020,"height":28,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":101,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1722400000000,"link":null,"locked":false,"text":"SPIFFE / SPIRE  ×  OAuth 2.1 (Keycloak)  ×  MCP  ×  EJBCA   —   trust domain: spiffe://lab.internal","fontSize":22,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"SPIFFE / SPIRE  ×  OAuth 2.1 (Keycloak)  ×  MCP  ×  EJBCA   —   trust domain: spiffe://lab.internal","autoResize":true,"lineHeight":1.25},
    {"id":"t-legend","type":"text","x":280,"y":52,"width":1020,"height":17,"angle":0,"strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":102,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1722400000000,"link":null,"locked":false,"text":"Solid green = built (M1–M3, branch m3-ejbca). Dashed gray = planned (M4–M9). The ONLY bridge between SPIFFE and OIDC is RFC 8693 token exchange. Not a WIMSE implementation.","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Solid green = built (M1–M3, branch m3-ejbca). Dashed gray = planned (M4–M9). The ONLY bridge between SPIFFE and OIDC is RFC 8693 token exchange. Not a WIMSE implementation.","autoResize":true,"lineHeight":1.25},

