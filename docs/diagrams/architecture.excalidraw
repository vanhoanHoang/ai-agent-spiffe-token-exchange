    {"id":"t-forbidden","type":"text","x":95,"y":890,"width":330,"height":81,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":120,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1722400000000,"link":null,"locked":false,"text":"FORBIDDEN (CLAUDE.md §2):\n• JWT-SVID as the MCP bearer token\n• user authorization derived from a SPIFFE ID\n• accepting a token whose aud ≠ this server\n• permissions wider than user ∩ agent scopes","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"FORBIDDEN (CLAUDE.md §2):\n• JWT-SVID as the MCP bearer token\n• user authorization derived from a SPIFFE ID\n• accepting a token whose aud ≠ this server\n• permissions wider than user ∩ agent scopes","autoResize":true,"lineHeight":1.25},

    {"id":"r-truststores","type":"rectangle","x":950,"y":880,"width":480,"height":140,"angle":0,"strokeColor":"#f08c00","backgroundColor":"#fff9db","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":121,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1722400000000,"link":null,"locked":false},
    {"id":"t-truststores","type":"text","x":965,"y":888,"width":450,"height":114,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":122,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1722400000000,"link":null,"locked":false,"text":"THREE TRUST STORES — never conflate:\n1. SPIFFE bundle (lab.internal): validates SVIDs + JWT-SVID\n    assertions — MUST NOT be the system store (draft §5.2.3)\n2. System / Web PKI: HTTPS server certs only\n    (the AS, the bundle endpoint) — never validates any SVID\n3. Keycloak realm JWKS: mcp-server validates access tokens","fontSize":12,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"THREE TRUST STORES — never conflate:\n1. SPIFFE bundle (lab.internal): validates SVIDs + JWT-SVID\n    assertions — MUST NOT be the system store (draft §5.2.3)\n2. System / Web PKI: HTTPS server certs only\n    (the AS, the bundle endpoint) — never validates any SVID\n3. Keycloak realm JWKS: mcp-server validates access tokens","autoResize":true,"lineHeight":1.25},

