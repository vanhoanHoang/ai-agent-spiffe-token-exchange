    {"id":"t-mcp","type":"text","x":1075,"y":372,"width":330,"height":130,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":110,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":null,"updated":1722400000000,"link":null,"locked":false,"text":"mcp-server — Spring Boot resource server\n(planned: M4 OAuth RS, M5 SVID mTLS)\nenforces, in order:\n 1. peer SPIFFE ID allowlisted (mTLS)\n 2. token signature via Keycloak JWKS\n 3. aud == this server (anti-passthrough)\n 4. scopes = user ∩ agent-allowed\nlogs sub + act.sub · mcp.lab.internal:8443","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"mcp-server — Spring Boot resource server\n(planned: M4 OAuth RS, M5 SVID mTLS)\nenforces, in order:\n 1. peer SPIFFE ID allowlisted (mTLS)\n 2. token signature via Keycloak JWKS\n 3. aud == this server (anti-passthrough)\n 4. scopes = user ∩ agent-allowed\nlogs sub + act.sub · mcp.lab.internal:8443","autoResize":true,"lineHeight":1.25},

