<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Pinned in docs/VERSIONS.md (D-005). Do not bump here. -->
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>internal.lab</groupId>
    <artifactId>agent-client</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>agent-client</name>
    <description>SVID -&gt; token exchange -&gt; MCP call; M10 agentic loop on top</description>

    <properties>
        <java.version>21</java.version>
        <!-- Pinned in docs/VERSIONS.md (D-010). Do not bump here. -->
        <spring-ai.version>2.0.0</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- P2.5 web mode only (profile "web"): browser login for alice.
             CLI chat stays non-web (web-application-type=none). The exchange
             stays hand-rolled — oauth2-client here is alice's LOGIN, never
             the agent's credential (that is the JWT-SVID, and only it). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!-- LLM provider = deployment detail (BUILD-PLAN M10): the starter is the
             ONLY provider-specific piece; no org.springframework.ai.<provider>
             type may appear in code (scripts/check-p2.sh enforces it). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- Second wire protocol (D-039): any OpenAI-compatible hosted endpoint
             (Groq for the demo). Both starters ship; Spring AI's own selector
             `spring.ai.model.chat` (bound to LLM_PROVIDER, default ollama)
             decides which ChatModel autoconfigures — verified from both
             autoconfigure jars, not recalled. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- SyncMcpToolCallbackProvider + the MCP Java SDK (aggregator: mcp-core
             + mcp-json-jackson3), versions managed by the BOM (D-010). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.spiffe</groupId>
            <artifactId>java-spiffe-provider</artifactId>
            <!-- Pinned in docs/VERSIONS.md (D-006). Do not bump here. -->
            <version>0.8.17</version>
        </dependency>
        <dependency>
            <!-- The assertion-type URN and the exchange wire format live here,
                 once, shared with the second hop (CLAUDE.md §5). -->
            <groupId>internal.lab</groupId>
            <artifactId>delegation-common</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Dispatcher: CLI modes (M5-M9 checks) stay non-Spring;
                         "chat" boots the Spring chassis. -->
                    <mainClass>internal.lab.agent.AgentMain</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
