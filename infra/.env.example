# Copy this file to infra/.env (same folder) and fill in the key. infra/.env is
# gitignored on purpose: the key never enters the repo (CLAUDE.md §7, D-039).
# Save as plain UTF-8 (no BOM, not UTF-16). CRLF is fine.
#
#   Windows (PowerShell, from the repo root):
#     Copy-Item infra\.env.example infra\.env ; notepad infra\.env
#   Git Bash:
#     cp infra/.env.example infra/.env && nano infra/.env

# ollama (default, local, no key)  |  openai (any OpenAI-wire endpoint; Groq below)
LLM_PROVIDER=openai

# From https://console.groq.com/keys (free tier, no card). Paste the whole gsk_... value.
LLM_API_KEY=<paste your gsk_ key here>

# Defaults live in infra/llm-env.sh; override only for another endpoint.
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_MODEL=openai/gpt-oss-120b
