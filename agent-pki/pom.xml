<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Pinned in docs/VERSIONS.md (D-005). Do not bump here. -->
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>internal.lab</groupId>
    <artifactId>agent-pki</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>agent-pki</name>
    <description>The PKI agent — second hop of the delegation chain (M12). Holds no LLM.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>io.spiffe</groupId>
            <artifactId>java-spiffe-provider</artifactId>
            <!-- Pinned in docs/VERSIONS.md (D-006). Do not bump here. -->
            <version>0.8.17</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
            <!-- Pinned in docs/VERSIONS.md (D-010). Inbound protocol surface. -->
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <!-- Pinned in docs/VERSIONS.md (D-010). Outbound client to cert-service. -->
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <!-- The assertion-type URN and the exchange wire format (CLAUDE.md §5). -->
            <groupId>internal.lab</groupId>
            <artifactId>delegation-common</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
